run = "pip install flask && python3 dashboard/app.py"
entrypoint = "dashboard/app.py"
modules = ["python-3.11:v18-20230807-322e88b"]

[env]
PORT = "5000"
SECRET_KEY = "change-this-to-a-real-secret-key"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "pip install flask && python3 dashboard/app.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80
